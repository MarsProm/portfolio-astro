---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, whatsappUrl } from '../data/profile';

const projects = (await getCollection('projects'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy" data-reveal data-visible="true">
      <p class="eyebrow">Desarrollo web · Santiago del Estero, Argentina</p>
      <h1 class="hero-title">Construyo productos digitales <em>claros</em>, útiles y listos para crecer.</h1>
      <p class="hero-intro">Soy {profile.name}. Diseño y desarrollo experiencias web completas para negocios que necesitan convertir una idea en una herramienta real.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#trabajos" class="button button-dark">Ver trabajos <span aria-hidden="true">↓</span></a>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="button button-outline">Contarme tu idea <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="hero-note" data-reveal data-visible="true">
      <span class="availability-dot" aria-hidden="true"></span>
      <p>Disponible para nuevos proyectos</p>
      <p class="mt-5 text-ink/55">Estrategia, interfaz y desarrollo en un proceso directo.</p>
    </aside>
    <div class="work-line" aria-hidden="true">
      <span>Idea</span><i></i><span>Producto</span><i></i><span>Resultado</span>
    </div>
  </section>

  <section id="trabajos" class="section shell scroll-mt-24">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">Trabajo seleccionado</p>
        <h2 class="mt-4 text-5xl sm:text-7xl">Tres formas de resolver.</h2>
      </div>
      <p class="section-lead">Productos, landing pages y sitios institucionales. El formato cambia; la búsqueda de claridad se mantiene.</p>
    </div>
    <div class="mt-14 grid gap-20 sm:mt-20 sm:gap-28">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <section id="servicios" class="services section scroll-mt-24">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow eyebrow-light">Cómo puedo ayudarte</p>
          <h2 class="mt-4 max-w-3xl text-5xl text-white sm:text-7xl">De la primera conversación al producto publicado.</h2>
        </div>
        <p class="section-lead text-white/65">Trabajo de punta a punta para que cada decisión visual también resuelva una necesidad del negocio.</p>
      </div>
      <div class="mt-16 grid border-t border-white/20 lg:grid-cols-3">
        <article class="service-card" data-reveal>
          <p class="service-number">01</p>
          <h3>Producto y estrategia</h3>
          <p>Ordeno objetivos, usuarios y alcance para definir qué construir primero y por qué.</p>
        </article>
        <article class="service-card" data-reveal>
          <p class="service-number">02</p>
          <h3>Diseño de interfaz</h3>
          <p>Creo sistemas visuales claros, accesibles y coherentes con la identidad del negocio.</p>
        </article>
        <article class="service-card" data-reveal>
          <p class="service-number">03</p>
          <h3>Desarrollo web</h3>
          <p>Implemento sitios y aplicaciones responsive con código mantenible y buen rendimiento.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="about-grid">
      <div data-reveal>
        <p class="eyebrow">Sobre mi trabajo</p>
        <h2 class="mt-5 max-w-3xl text-5xl sm:text-7xl">Código con criterio de producto.</h2>
      </div>
      <div class="about-copy" data-reveal>
        <p>No separo lo técnico de la experiencia. Antes de elegir una tecnología, busco entender qué tiene que lograr el producto y quién necesita usarlo.</p>
        <p>Trabajo con JavaScript, TypeScript, Astro, Tailwind, Laravel, Python y bases de datos. También incorporo herramientas de IA cuando mejoran el proceso, no como decoración.</p>
        <div class="mt-8 flex flex-wrap gap-5">
          <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">Ver GitHub ↗</a>
          <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a class="text-link" href={profile.cv} target="_blank" rel="noopener noreferrer">Descargar CV ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
