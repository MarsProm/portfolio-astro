---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; index: number; }
const { project, index } = Astro.props;
const { data } = project;
---

<article class="project-card" data-reveal>
  <a class="project-image-wrap group" href={`/proyectos/${project.id}/`} aria-label={`Ver caso de estudio: ${data.title}`}>
    <img class="project-image" src={data.cover} alt={data.coverAlt} loading={index === 0 ? 'eager' : 'lazy'} />
    <span class="project-open" aria-hidden="true">Abrir caso ↗</span>
  </a>
  <div class="grid gap-4 pt-6 md:grid-cols-[9rem_1fr]">
    <p class="project-index">0{index + 1} / {data.year}</p>
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <h3 class="text-3xl sm:text-4xl"><a class="title-link" href={`/proyectos/${project.id}/`}>{data.title}</a></h3>
        {data.status === 'conceptual' && <span class="status-badge">Conceptual</span>}
      </div>
      <p class="mt-3 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">{data.summary}</p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías utilizadas">
        {data.stack.slice(0, 4).map((item) => <li class="tag">{item}</li>)}
      </ul>
    </div>
  </div>
</article>
